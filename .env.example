# --- Database (Neon Postgres) ---
# Neon gives you a "postgres://" URL - convert to asyncpg driver form:
# postgres://user:pass@host/db?sslmode=require
#   -> postgresql+asyncpg://user:pass@host/db
DATABASE_URL=postgresql://neondb_owner:npg_1YqheuAymX2E@ep-spring-truth-a1wsihjx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# --- Auth / JWT ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_DOMAIN=
# set to your Vercel domain in prod, e.g. .yourapp.com
COOKIE_SECURE=false
# true in production (Render + Vercel are both https)

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
# where the user lands after Google login succeeds

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Gemini (Phase 1B) ---
GEMINI_API_KEY=your-gemini-key
